    <RootNamespace>career_wide</RootNamespace>
    <UserSecretsId>2ed5f7ec-28ce-449c-9cae-972a3390725a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
