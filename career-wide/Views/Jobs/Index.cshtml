@model IEnumerable<career_wide.Models.Job.JobListing>

@{
    ViewData["Title"] = "Open Jobs";
}

<div class="container py-4">
    <h1 class="mb-4">Open jobs</h1>

    @if (!Model.Any())
    {
        <p>There are no open positions right now. Please check back soon.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var job in Model)
            {
                <div class="col">
                    <article class="card job-card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title h4">@job.Title</h2>

                            <p class="text-muted mb-2">
                                @job.CompanyName · @job.Location
                            </p>

                            <p class="mb-3">
                                <strong>Employment type:</strong>
                                @job.EmploymentType
                            </p>
                            @if (!string.IsNullOrWhiteSpace(job.SalaryRange))
                            {
                                <p class="mb-2">
                                    <strong>Salary range:</strong> @job.SalaryRange
                                </p>
                            }
                            <p class="card-text job-description">
                                @job.Description
                            </p>

                            <div class="mt-auto">
                                <p class="mb-3">
                                    <strong>Apply by:</strong>
                                    @job.ClosingDate.ToString("d")
                                </p>

                                <a asp-action="Apply"
                                   asp-route-id="@job.Id"
                                   class="btn btn-primary">
                                    Apply
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>